{
  "trailingSlash": false,
  "rewrites": [
    { "source": "/homeowners", "destination": "/homeowners/index.html" },
    { "source": "/driving-range", "destination": "/driving-range/index.html" },
    { "source": "/hoa", "destination": "/hoa/index.html" },
    { "source": "/other-nets", "destination": "/other-nets/index.html" },
    { "source": "/gallery", "destination": "/gallery/index.html" },
    { "source": "/about", "destination": "/about/index.html" },
    { "source": "/faq", "destination": "/faq/index.html" },
    { "source": "/contact", "destination": "/contact/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "index, follow" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" }
      ]
    },
    {
      "source": "/404.html",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/images/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(favicon-48.png|apple-touch-icon.png|icon-192.png|icon-512.png|site.webmanifest)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    },
    {
      "source": "/(robots.txt|sitemap.xml|llms.txt)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    }
  ]
}
